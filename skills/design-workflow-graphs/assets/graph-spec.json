{
  "schema_version": "1",
  "graph": {
    "id": "proposal_workflow",
    "goal": "Produce, review, and publish an approved proposal.",
    "entry": "intake",
    "terminals": [
      "done",
      "failed"
    ],
    "controls": {
      "max_steps": 20,
      "timeout": "30m"
    }
  },
  "state": [
    {
      "name": "request",
      "description": "Original request and acceptance criteria.",
      "type": "object",
      "owner": "input",
      "writers": [
        "intake"
      ],
      "merge": "replace",
      "sensitive": false,
      "persist": true,
      "initial": false
    },
    {
      "name": "research",
      "description": "Evidence collected for the proposal.",
      "type": "object",
      "owner": "research",
      "writers": [
        "research"
      ],
      "merge": "replace",
      "sensitive": false,
      "persist": true,
      "initial": false
    },
    {
      "name": "risks",
      "description": "Identified risks and mitigations.",
      "type": "object",
      "owner": "risk_assessment",
      "writers": [
        "risk_assessment"
      ],
      "merge": "replace",
      "sensitive": false,
      "persist": true,
      "initial": false
    },
    {
      "name": "proposal",
      "description": "Current proposal candidate.",
      "type": "object",
      "owner": "synthesize",
      "writers": [
        "synthesize",
        "revise"
      ],
      "merge": "replace",
      "sensitive": false,
      "persist": true,
      "initial": false
    },
    {
      "name": "review_decision",
      "description": "Structured review outcome and feedback.",
      "type": "object",
      "owner": "review",
      "writers": [
        "review"
      ],
      "merge": "replace",
      "sensitive": false,
      "persist": true,
      "initial": false
    },
    {
      "name": "approval_decision",
      "description": "Durable approval outcome used to resume publication.",
      "type": "object",
      "owner": "approval",
      "writers": [
        "approval"
      ],
      "merge": "replace",
      "sensitive": false,
      "persist": true,
      "initial": false
    }
  ],
  "nodes": [
    {
      "id": "intake",
      "kind": "task",
      "purpose": "Normalize the request and acceptance criteria.",
      "reads": [

      ],
      "writes": [
        "request"
      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "1m",
      "retry": {
        "max_attempts": 1
      },
      "failure": {
        "classification": "terminal",
        "on_failure": "failed"
      }
    },
    {
      "id": "research",
      "kind": "task",
      "purpose": "Gather evidence relevant to the request.",
      "reads": [
        "request"
      ],
      "writes": [
        "research"
      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "5m",
      "retry": {
        "max_attempts": 2
      },
      "failure": {
        "classification": "retryable",
        "on_failure": "failed"
      }
    },
    {
      "id": "risk_assessment",
      "kind": "task",
      "purpose": "Identify material risks and mitigations.",
      "reads": [
        "request"
      ],
      "writes": [
        "risks"
      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "5m",
      "retry": {
        "max_attempts": 2
      },
      "failure": {
        "classification": "retryable",
        "on_failure": "failed"
      }
    },
    {
      "id": "synthesize",
      "kind": "join",
      "purpose": "Combine evidence and risks into a proposal.",
      "reads": [
        "request",
        "research",
        "risks"
      ],
      "writes": [
        "proposal"
      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "3m",
      "retry": {
        "max_attempts": 1
      },
      "failure": {
        "classification": "correctable",
        "on_failure": "failed"
      },
      "join": {
        "strategy": "all"
      }
    },
    {
      "id": "review",
      "kind": "router",
      "purpose": "Decide whether the proposal meets the acceptance criteria.",
      "reads": [
        "request",
        "proposal"
      ],
      "writes": [
        "review_decision"
      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "2m",
      "retry": {
        "max_attempts": 1
      },
      "failure": {
        "classification": "correctable",
        "on_failure": "failed"
      }
    },
    {
      "id": "revise",
      "kind": "task",
      "purpose": "Revise the proposal using actionable review feedback.",
      "reads": [
        "proposal",
        "review_decision"
      ],
      "writes": [
        "proposal"
      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "3m",
      "retry": {
        "max_attempts": 1
      },
      "failure": {
        "classification": "correctable",
        "on_failure": "failed"
      }
    },
    {
      "id": "approval",
      "kind": "approval",
      "purpose": "Pause for a durable external approval decision.",
      "reads": [
        "request",
        "proposal",
        "review_decision"
      ],
      "writes": [
        "approval_decision"
      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "24h",
      "retry": {
        "max_attempts": 1
      },
      "failure": {
        "classification": "rejectable",
        "on_failure": "failed"
      },
      "approval": {
        "decision_state": "approval_decision",
        "resume_state": [
          "request",
          "proposal",
          "review_decision"
        ],
        "on_rejected": "failed",
        "on_expired": "failed"
      }
    },
    {
      "id": "publish",
      "kind": "side_effect",
      "purpose": "Publish the approved proposal exactly once.",
      "reads": [
        "proposal"
      ],
      "writes": [

      ],
      "side_effects": [
        "publish_proposal"
      ],
      "idempotent": true,
      "timeout": "2m",
      "retry": {
        "max_attempts": 2
      },
      "failure": {
        "classification": "retryable",
        "on_failure": "failed"
      }
    },
    {
      "id": "done",
      "kind": "terminal",
      "purpose": "Mark the workflow complete.",
      "reads": [
        "proposal"
      ],
      "writes": [

      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "1m",
      "retry": {
        "max_attempts": 1
      }
    },
    {
      "id": "failed",
      "kind": "terminal",
      "purpose": "End the workflow after rejection, exhaustion, cancellation, or failure.",
      "reads": [

      ],
      "writes": [

      ],
      "side_effects": [

      ],
      "idempotent": true,
      "timeout": "1m",
      "retry": {
        "max_attempts": 1
      }
    }
  ],
  "edges": [
    {
      "from": "intake",
      "to": "research"
    },
    {
      "from": "intake",
      "to": "risk_assessment"
    },
    {
      "from": "research",
      "to": "synthesize"
    },
    {
      "from": "risk_assessment",
      "to": "synthesize"
    },
    {
      "from": "synthesize",
      "to": "review"
    },
    {
      "from": "review",
      "to": "approval",
      "when": "review_decision.status == \"approved\"",
      "reads": [
        "review_decision"
      ]
    },
    {
      "from": "review",
      "to": "revise",
      "default": true
    },
    {
      "from": "revise",
      "to": "review"
    },
    {
      "from": "approval",
      "to": "publish",
      "when": "approval_decision.status == \"approved\"",
      "reads": [
        "approval_decision"
      ]
    },
    {
      "from": "approval",
      "to": "failed",
      "default": true
    },
    {
      "from": "publish",
      "to": "done"
    }
  ],
  "parallel_groups": [
    {
      "id": "analysis",
      "branches": [
        "research",
        "risk_assessment"
      ],
      "join": "synthesize",
      "on_partial_failure": "failed"
    }
  ],
  "loops": [
    {
      "id": "proposal_revision",
      "nodes": [
        "review",
        "revise"
      ],
      "exit_when": "review_decision.status == \"approved\"",
      "reads": [
        "review_decision"
      ],
      "evaluate_after": "review",
      "max_iterations": 3,
      "on_exhausted": "failed"
    }
  ],
  "recovery": {
    "checkpoint_state": [
      "request",
      "proposal",
      "review_decision",
      "approval_decision"
    ],
    "on_unhandled_error": "failed",
    "on_cancel": "failed"
  },
  "evaluation": {
    "checks": [
      {
        "scope": "route",
        "target": "review",
        "metric": "review_route_accuracy"
      },
      {
        "scope": "graph",
        "target": "proposal_workflow",
        "metric": "approved_proposal_published_once"
      }
    ]
  },
  "observability": {
    "capture": [
      "node_start",
      "node_end",
      "edge_selected",
      "state_delta",
      "retry",
      "latency",
      "error"
    ],
    "redact_sensitive_state": true
  }
}
